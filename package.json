{
  "name": "simple-ascii-chart-cli",
  "version": "4.0.0",
  "description": "Simple ascii chart generator CLI",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "simple-ascii-chart": "dist/cli.js",
    "simple-ascii-chart-cli": "dist/cli.js"
  },
  "scripts": {
    "start": "tsc-watch -p tsconfig.json --preserveWatchOutput -w --onSuccess 'node ./dist/cli.js --help'",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "snapshots:generate": "npm run build --silent && node dist/examples/generate-snapshots.js",
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json -w",
    "prepare": "npm run lint && npm run build && npm test"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.15.17",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsdoc": "^62.9.0",
    "globals": "^16.5.0",
    "jest": "^30.3.0",
    "prettier": "^3.5.3",
    "ts-jest": "^29.3.2",
    "tsc-watch": "^6.2.1",
    "typescript": "^5.8.3"
  },
  "keywords": [
    "ascii",
    "js",
    "ts",
    "cli",
    "chart"
  ],
  "author": "gtktsc",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gtktsc/simple-ascii-chart-cli.git"
  },
  "bugs": {
    "url": "https://github.com/gtktsc/simple-ascii-chart-cli/issues"
  },
  "homepage": "https://github.com/gtktsc/simple-ascii-chart-cli#readme",
  "files": [
    "dist/**/*"
  ],
  "dependencies": {
    "simple-ascii-chart": "^6.0.0",
    "yargs": "^17.7.2"
  },
  "resolutions": {
    "@babel/core": "^7.29.7",
    "js-yaml": "^4.3.0"
  }
}
